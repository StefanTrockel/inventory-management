# Copy to .env and fill in values. .env is gitignored.

# GitHub Personal Access Token used by the GitHub MCP server (.mcp.json).
# Create one at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Backend CORS: comma-separated list of allowed frontend origins.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 when unset.
# ALLOWED_ORIGINS=http://localhost:3000

# Frontend API base URL override (defaults to /api via the Vite dev proxy).
# VITE_API_BASE_URL=/api
